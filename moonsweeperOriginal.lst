                1100        .IN MOON.CODE.1,D1
                1000 *--------------------------------
                1010 * FILE>MOON.CODE.1
                1020 *--------------------------------
0860- 78        1030 COLD.START          SEI                          TURN OFF INTERRUPTS
0861- 20 37 0E  1040                     JSR INIT.IO                  SETUP I/O HARDWARE
0864- A9 00     1050                     LDA #$00
0866- AA        1060                     TAX
0867- 9D        1070 .1                  .HS 9D                       OPCODE FOR STA $ZZZZ,X
0868- 05 00     1080                     .DA TEMP1                    BYTES FOR ADDRESS OF STA
086A- 9D 00 D0  1090                     STA $D000,X                  CLEAR 6566 VIDEO REGISTERS
086D- 9D 00 D4  1100                     STA $D400,X                  CLEAR 6581 SID REGISTERS
0870- E8        1110                     INX
0871- D0 F4     1120                     BNE .1
0873- 9A        1130                     TXS                          RESET STACK POINTER
0874- 20 51 0D  1140                     JSR INIT.HARDWARE
0877- 20 72 0E  1150                     JSR INIT.GAME
                1160 *--------------------------------
                1170 * DO THE GALAXY SCREEN
                1180 *--------------------------------
087A- 20 C2 0F  1190 GALAXY.LOOP         JSR HYPER.SPACE              DO HYPERSPACE PICTURE
087D- 20 DC 0E  1200                     JSR MOVE.SCREEN              PUT IN UNIVERSE
0880- 20 4D 11  1210                     JSR PICK.GALAXY              GET GALAXY CHOSEN
0883- 20 C2 0F  1220                     JSR HYPER.SPACE              DO HYPERSPACE PICTURE
0886- 20 DC 0E  1230                     JSR MOVE.SCREEN              PUT IN ORBIT
                1240 *--------------------------------
                1250 * DO THE ORBIT SCREEN
                1260 *--------------------------------
0889- 20 A4 08  1270                     JSR INIT.ORBIT               SET UP ORBIT SCREEN
                1280 *--------------------------------
                1290 * ORBIT LOOP
                1300 *--------------------------------
088C- 20 17 09  1310 ORBIT.LOOP          JSR DO.SHIP                  UPDATE SHIP
088F- 20 4A 0C  1320                     JSR DO.FUEL                  UPDATE FUEL
0892- 20 F2 0C  1330                     JSR BLOW.UP.SHIP             KILL SHIP IF NEEDED
0895- 20 8C 0B  1340                     JSR UPDATE.SHOT              UPDATE A SHOT
0898- 20 41 12  1350                     JSR DO.ORBIT                 MOVE ORBIT SPRITES
089B- 20 49 14  1360                     JSR COLLISION.DETECT         CHECK FOR COLLISIONS
089E- 20 E0 23  1370                     JSR DO.SOUNDS
08A1- 4C 8C 08  1380                     JMP ORBIT.LOOP               DO IT AGAIN
                1390 *--------------------------------
                1400 * INITIALIZE ORBIT SCENE
                1410 *--------------------------------
08A4- AD 16 D0  1420 INIT.ORBIT          LDA VIC.CONTROL.2            TURN ON MULTI COLOR MODE!
08A7- 09 10     1430                     ORA #$10
08A9- 8D 16 D0  1440                     STA VIC.CONTROL.2
08AC- A9 08     1450                     LDA #$08
08AE- 85 D7     1460                     STA START.DELAY
08B0- A9 02     1470                     LDA #$02
08B2- 85 68     1480                     STA UPDATE.DELAY+1
08B4- A9 20     1490                     LDA #$20
08B6- 85 6D     1500                     STA SPEED.DELAY
08B8- A9 C4     1510                     LDA #$C4
08BA- 85 52     1520                     STA FUEL.IND
08BC- A9 30     1530                     LDA #$30
08BE- 85 5C     1540                     STA FUELX
08C0- A9 40     1550                     LDA #FUELBURN
08C2- 85 60     1560                     STA FUEL.DELAY
08C4- 20 B5 0E  1570                     JSR DO.MOON.INDICATOR        SHOW NUMBER OF MOONS TO LANDD
08C7- A9 10     1580                     LDA #$10
08C9- 8D 12 D0  1590                     STA RASTER                   SET INTERRUPT LINE

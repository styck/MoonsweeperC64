               1000 *--------------------------------
               1010 * MOONSWEEPER C-64 VERSION
               1020 * (C) 1984 IMAGIC
               1030 * BY DANIEL FILIBERTI
               1040 * A.C.T
               1050 *--------------------------------
               1060 *      .TI 55,MOONSWEEPER C-64

                1080        .IN MOON.MACROS,D1
                1000 *--------------------------------
                1010 * FILE>MOON.MACROS
                1020 *--------------------------------
                1030 * ADD AN 8BIT VALUE TO A
                1040 * 16 BIT RESULT
                1050 * FORMAT IS >ADD ]1,]2,]3
                1060 * ]1=BYTE TO ADD ]2=LOW ANSWER
                1070 *--------------------------------
                1080            .MA ADD
                1090            LDA #]1
                1100            CLC
                1110            ADC ]2
                1120            STA ]2
                1130            BCC :1
                1140            INC ]2+1
                1150 :1
                1160            .EM
                1170 *--------------------------------
                1180 * SUBTRACT AN 8BIT VALUE TO A
                1190 * 16 BIT RESULT
                1200 * FORMAT IS >SUB ]1,]2,]3
                1210 * ]1=BYTE TO ADD ]2=LOW ANSWER
                1220 *--------------------------------
                1230            .MA SUB
                1240            LDA ]1
                1250            SEC
                1260            SBC #]2
                1270            STA ]1
                1280            BCS :1
                1290            DEC ]1+1
                1300 :1
                1310            .EM
                1320 *--------------------------------
                1330 * BUILD A POINTER IN ZERO PAGE
                1340 *--------------------------------
                1350 * FORMAT >BUILD ]1,]2
                1360 * ]1=WHERE TO POINT TO IN MEMORY
                1370 * ]2=ZERO PAGE ADDRESS OF POINTER
                1380 *--------------------------------
                1390            .MA BUILD
                1400            LDA #]1
                1410            STA ]2
                1420            LDA /]1
                1430            STA ]2+1
                1440            .EM
                1450 *--------------------------------
                1460 * INCREMENT A 16 BIT VALUE
                1470 *--------------------------------
                1480            .MA INC
                1490            LDA ]1
                1500            CLC
                1510            ADC #$01
                1520            STA ]1
                1530            BCC :1
                1540            INC ]1+1
                1550 :1
                1560            .EM
                1570 *--------------------------------
                1580 * PRINT ROUTINE MACRO
                1590 * ENTER WITH ]1=XCOOR, ]2=YCOOR
                1600 * ]3=COLOR ]4=STRING TO PRINT!
                1610 *--------------------------------
                1620            .MA PRINT
                1630            LDX #]1
                1640            LDY #]2
                1650            LDA #]3
                1660            STA PRINT.COLOR
                1670            JSR PRINT
                1680            .AS -"]4"
                1690            .HS FF
                1700            .EM
                1090        .IN MOON.EQUATES,D1
                1000 *--------------------------------
                1010 * FILE>MOON.EQUATES
                1020 *--------------------------------
                1030            .OR $0860
                1040            .TF OBJECT,D2
                1050 *--------------------------------
                1060 * PROGRAM EQUATES
                1070 *--------------------------------
                1080 * PROGRAMMING EQUATES
                1090 *--------------------------------
                1100 * PROGRAM SPACE $0800-$3FFF
                1110 * CHARACTER SET $4000-$4800
                1120 * SCREEN MEMORY $4800-$4C00
                1130 * SPRITE MEMORY $4C00-$8000
                1140 * COLOR MEMORY  $D800-$DC00
                1150 * VARIABLES     $0400-$0800
                1160 *               $8000-$????
                1170 *--------------------------------
                1180 * PROGRAM EQUATES
                1190 *--------------------------------
4000-           1200 CHARACTER.MEMORY    .EQ $4000                    CHARACTER SET
4800-           1210 SCREEN.MEMORY       .EQ $4800                    SCREEN MEMORY
4BF8-           1220 SPRITE.POINTER      .EQ SCREEN.MEMORY+$3F8       SPRITE POINTERS
4C00-           1230 SPRITE.MEMORY       .EQ $4C00                    SPRITE MEMORY
D800-           1240 COLOR.MEMORY        .EQ $D800                    COLOR MEMORY
                1250 *--------------------------------
                1260 * VIDEO HARDWARE EQUATES
                1270 *--------------------------------
D020-           1280 BORDER.COLOR        .EQ $D020
D021-           1290 BACKGROUND.COLOR    .EQ $D021
D022-           1300 MCOL1               .EQ $D022
D023-           1310 MCOL2               .EQ $D023
D000-           1320 SPRITE.XPOS         .EQ $D000                    PLUS 2*SPRITE NUMBER!
D001-           1330 SPRITE.YPOS         .EQ $D001                    PLUS 2*SPRITE NUMBER!
D010-           1340 SPRITE.XMSB         .EQ $D010                    HIGH BIT OF XPOSITION
D011-           1350 VIC.CONTROL.1       .EQ $D011                    VIC CONTROL REGISTER
D012-           1360 RASTER              .EQ $D012                    RASTER REGISTER
D015-           1370 SPRITE.ENABLE       .EQ $D015                    SPRITE ENABLE REGISTER
D016-           1380 VIC.CONTROL.2       .EQ $D016                    SCROLL AND MULTI-COLOR
D017-           1390 SPRITE.YXPAND       .EQ $D017                    Y-EXPANSION OF SPRITES
D018-           1400 VIC.MEMORY          .EQ $D018                    MEMORY BANK CONTROL
D019-           1410 VIC.IRQ             .EQ $D019                    INTERRUPT FLAGS
D01A-           1420 IRQ.ENABLE          .EQ $D01A                    ENABLES INTERRUPTS
D01B-           1430 SPRITE.PRIORITY     .EQ $D01B                    SPRITE TO BACKGROUND
D01C-           1440 SPRITE.MULTI.COLOR  .EQ $D01C                    SPRITE MULTI COLOR
D01D-           1450 SPRITE.XXPAND       .EQ $D01D                    X-EXPANSION OF SPRITES
D01E-           1460 SPRITE.SCOLIDE      .EQ $D01E                    SPRITE TO SPRITE COLLISION
D01F-           1470 SPRITE.BCOLIDE      .EQ $D01F                    SPRITE TO BACKGROUND COLLISION
D025-           1480 SPRITE.MCOLOR.0     .EQ $D025                    COLOR REGISTER
D026-           1490 SPRITE.MCOLOR.1     .EQ $D026                    COLOR REGISTER
D027-           1500 SPRITE.COLOR        .EQ $D027                    MAIN SPRITE COLOR,SPRITE NUMBER
